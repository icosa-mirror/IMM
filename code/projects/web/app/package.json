{
  "name": "@imm/web-player",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:blue-noise": "node scripts/generate-blue-noise.mjs",
    "prebuild": "node scripts/generate-blue-noise.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tests/verify-cache-versioning.mjs",
    "build:library": "node scripts/build-library.mjs",
    "build:library:ci": "node scripts/build-library.mjs --decoder-ready",
    "build:library:bundle": "vite build --config vite.library.config.mjs && tsc -p tsconfig.library.json && node tests/verify-library-package.mjs",
    "test": "bun test",
    "preview": "vite preview",
    "test:browser:smoke": "node tests/web-player-smoke.mjs",
    "test:browser": "node tests/web-player-browser.mjs",
    "test:browser:firefox": "node tests/web-player-firefox.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "playwright-core": "1.61.1",
    "typescript": "5.9.3",
    "vite": "7.1.7"
  }
}
